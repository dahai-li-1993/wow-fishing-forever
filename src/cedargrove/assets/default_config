# cedargrove configuration. Delete any line to go back to its default.

[game]
# Keybind for the Fishing ability on your action bar.
cast_key = "1"
# Keybind for Interact With Target (Options > Keybindings > Targeting).
interact_key = "f"
# Stop fishing after this many minutes. Set to 0 to run Forever!
session_minutes = 0

[vision]
# Optional. The bot fishes by sound; the icon only shows the bobber in the GUI and spots it
# vanishing after Interact. On-screen size of the interact icon in pixels. 0 = not calibrated;
# `cedargrove calibrate` (or the GUI Setup tab) sets it.
icon_size_px = 0
icon_native_size = 0
# Minimum match score (0..1) to accept the icon (values above 0.78 are treated as 0.78).
icon_threshold = 0.75
# Frames wider than this are downscaled before matching.
match_width = 1920

[audio]
# "game": hear only the game's own audio stream (Linux PipeWire, Windows 10 2004+), so music or
# videos in other applications cannot drown the splash. "device": hear the loopback `device`.
capture = "game"
# Loopback device id or name substring, used when capture = "device". Empty = monitor of the
# default output.
device = ""
bite_threshold = 0.66
# Ignore further bites for this many seconds after one fires.
refractory_s = 3.0

[run]
# Look for the gear icon for this many seconds after casting (it never causes a recast).
icon_timeout_s = 4.0
# Recast if no splash is heard this many seconds after casting.
cast_timeout_s = 30.0
# After pressing Interact, wait this long for Auto Loot before casting again (less when the
# gear icon is seen to vanish; a miss when it is still there at the end).
loot_timeout_s = 3.0
# Random pause between actions, in seconds.
pause_min_s = 0.5
pause_max_s = 2.0
# How long each key is held down, in milliseconds.
key_hold_ms = 60
